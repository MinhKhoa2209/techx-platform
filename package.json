{
  "name": "techx-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "src/catalog-api",
    "src/order-api",
    "src/frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:backend": "npm run test -w @techx/catalog-api && npm run test -w @techx/order-api"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "tsx": "4.23.5",
    "typescript-eslint": "8.66.0",
    "typescript": "5.9.3"
  }
}
